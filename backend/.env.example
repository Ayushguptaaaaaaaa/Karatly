# Copy to .env and fill in real values. Never commit .env.

# ---------- App ----------
APP_NAME=Kraftly
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---------- Demo shop ----------
SHOP_NAME=Demo Jewellers
OWNER_NAME=Shop Owner
CURRENCY=INR
TIMEZONE=Asia/Kolkata

# ---------- Auth (demo logins) ----------
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=owner
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin

# ---------- Files ----------
PHOTO_DIR=./data/photos
MAX_PHOTO_MB=3

# ---------- Database ----------
DATABASE_URL=sqlite:///./data/jeweler.db

# ---------- LLM (Google Gemini free tier) ----------
LLM_MODEL=gemini/gemini-3.6-flash
LLM_FALLBACK_MODEL=gemini/gemini-3.1-flash-lite
LLM_CHAT_MODEL=gemini/gemini-3.1-flash-lite      # fast model for the chatbot
LLM_CHAT_TIMEOUT_SECONDS=25
CHAT_INSTANT_ANSWERS=true                         # common questions answered instantly from data
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
LLM_MAX_RPM=4
AGENT_MAX_ITER=5
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_FALLBACK_ON_STATUS=429,503
LLM_MOCK_MODE=false

# ---------- Business defaults ----------
DEFAULT_INFLATION_PCT=5
DEFAULT_MIN_STOCK=3
DEAD_STOCK_DAYS=90
REORDER_COVER_MONTHS=1.5
QUARTER_SYSTEM=FINANCIAL

# ---------- Privacy ----------
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
